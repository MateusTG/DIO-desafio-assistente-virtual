# Copie para .env e preencha.

# ---------------------------------------------------------------- LLM
# "anthropic" (Claude via API) ou "ollama" (local e gratuito)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Ollama: use um modelo com suporte a ferramentas (ollama pull qwen2.5)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# ---------------------------------------------------------------- Jarvis
# demo = tudo simulado com data/mock | real = usa as APIs abaixo que estiverem configuradas
JARVIS_MODO=demo
JARVIS_FUSO=America/Sao_Paulo
# Fixa a data atual (AAAA-MM-DD), útil para demonstrar o planejamento de domingo
# JARVIS_HOJE=2026-10-11

# ---------------------------------------------------------------- Integrações (veja docs/06-integracoes.md)
GOOGLE_CREDENCIAIS=credentials.json
GOOGLE_TOKEN=token.json
GOOGLE_CALENDAR_ID=primary
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
SLACK_BOT_TOKEN=
SLACK_CANAL_ID=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
NOTION_TOKEN=
NOTION_PAGINA_PAI_ID=
